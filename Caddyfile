:{$PORT:8080} {
	# Fly health check (own handle block so the SPA fallback can't rewrite it)
	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv
		encode gzip

		# Runtime status written by start.sh — never cache it
		header /status.json Cache-Control "no-store"

		# SPA fallback: unknown paths serve index.html
		try_files {path} /index.html
		file_server
	}
}
